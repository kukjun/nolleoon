{
  "name": "trip-court",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "check": "node tools/harness/check.mjs",
    "test:harness": "node tools/harness/discovery.mjs tests/harness",
    "build": "npm run build -w @trip-court/contracts && npm run build -w @trip-court/api && npm run build -w @trip-court/web",
    "test:workspace": "node tools/harness/discovery.mjs tests/workspace",
    "check:layers": "node tools/workspace/layers.mjs",
    "smoke:workspace": "node tools/workspace/smoke.mjs",
    "dev:web": "npm run dev -w @trip-court/web",
    "start:api": "npm run start -w @trip-court/api",
    "lint": "eslint apps packages tools/harness tools/workspace tools/security tools/storage tests/harness tests/workspace tests/unit tests/integration tests/database tests/browser tests/support playwright.config.mjs eslint.config.mjs",
    "typecheck": "tsc -p packages/contracts/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test:unit": "node tools/harness/discovery.mjs tests/unit",
    "test:integration": "node tools/harness/discovery.mjs tests/integration",
    "test:browser": "playwright test --reporter=json --grep-invert \"@e2e|@mobile\"",
    "test:database": "node tools/harness/discovery.mjs tests/database",
    "test:e2e": "playwright test --reporter=json --grep @e2e",
    "test:mobile": "playwright test --reporter=json --grep @mobile"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.11.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
