<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 검토용 예시. 자동 설치하지 않는다. 모든 경로와 도메인은 대체가 필요한 예시다. -->
  <!-- RunAtLoad/KeepAlive 변경 및 실제 등록은 별도 승인·운영 조건 확인 후 수행한다. -->
  <!-- 로그인 세션, 디스크 마운트, 잠금/절전 상태에서의 동작을 아직 검증하지 않았다. -->
  <key>Label</key><string>local.trip-court.example</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/node</string>
    <string>/absolute/private/releases/current/apps/api/dist/main.js</string>
  </array>
  <key>WorkingDirectory</key><string>/absolute/private/releases/current</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key><string>production</string>
    <key>API_HOST</key><string>127.0.0.1</string>
    <key>API_PORT</key><string>3101</string>
    <key>WEB_ROOT</key><string>/absolute/private/releases/current/apps/web/dist</string>
    <key>DB_PATH</key><string>/absolute/private/data/trip-court.sqlite</string>
    <key>PUBLIC_ORIGIN</key><string>https://tripcourt.example.com</string>
  </dict>
  <key>StandardOutPath</key><string>/absolute/private/logs/trip-court.stdout.log</string>
  <key>StandardErrorPath</key><string>/absolute/private/logs/trip-court.stderr.log</string>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
</dict>
</plist>
