# 검토용 예시만 제공한다. 실제 경로와 도메인을 확인한 뒤 별도 승인 범위에서 적용한다.
# 아래 포트는 격리 제안값이며 사용 가능 여부를 확인하지 않았다.
# env 파일은 자동 로드되지 않는다. 프로세스 실행 환경에 명시적으로 전달해야 한다.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3101
WEB_ROOT=/absolute/private/releases/current/apps/web/dist
DB_PATH=/absolute/private/data/trip-court.sqlite
PUBLIC_ORIGIN=https://tripcourt.example.com
